# 45Drives MPI3MR Driver Patch
# -----------------------------------------------------------------------------
# - Adds `slot` attribute to block devices for easier drive aliasing
# - Fixes kernel compat issues
#   - bsg_setup_queue() api change to add reply_len parameter
#
diff --git a/Makefile b/Makefile
index 50ac57f..870d5f9 100644
--- a/Makefile
+++ b/Makefile
@@ -8,3 +8,15 @@ mpi3mr-y +=  mpi3mr_os.o     \
 		mpi3mr_transport.o 
 
 
+bsg_setup_queue_has_reply_len := $(shell \
+    $(CC) $(NOSTDINC_FLAGS) $(LINUXINCLUDE) \
+    $(KBUILD_CPPFLAGS) $(KBUILD_CFLAGS) \
+    -x c -c -o /dev/null \
+    $(src)/probe_bsg_setup_queue_has_reply_len.c \
+    >/dev/null 2>&1 && echo y)
+
+$(info bsg_setup_queue_has_reply_len=$(bsg_setup_queue_has_reply_len))
+
+ifeq ($(bsg_setup_queue_has_reply_len),y)
+ccflags-y += -DMPI3MR_BSG_SETUP_QUEUE_HAS_REPLY_LEN
+endif
diff --git a/mpi3mr.h b/mpi3mr.h
index d160999..6efd0f4 100644
--- a/mpi3mr.h
+++ b/mpi3mr.h
@@ -80,7 +80,7 @@ extern spinlock_t mrioc_list_lock;
 extern struct list_head mrioc_list;
 extern atomic64_t event_counter;
 
-#define MPI3MR_DRIVER_VERSION	"8.19.1.0.0"
+#define MPI3MR_DRIVER_VERSION	"8.19.1.0.0-45d1"
 #define MPI3MR_DRIVER_RELDATE	"19-October-2026"
 
 
diff --git a/mpi3mr_app.c b/mpi3mr_app.c
index 3349f9e..df45725 100644
--- a/mpi3mr_app.c
+++ b/mpi3mr_app.c
@@ -3230,7 +3230,11 @@ static void mpi3mr_bsg_queue_creation(struct mpi3mr_ioc *mrioc,
 	};
 
 	mrioc->bsg_queue = bsg_setup_queue(bsg_dev, dev_name(bsg_dev), &lim,
-	    mpi3mr_bsg_request, NULL, 0);
+	    mpi3mr_bsg_request, NULL, 0
+#ifdef MPI3MR_BSG_SETUP_QUEUE_HAS_REPLY_LEN
+		, SCSI_SENSE_BUFFERSIZE
+#endif
+	);
 	if (IS_ERR(mrioc->bsg_queue)) {
 		ioc_err(mrioc, "%s: bsg registration failed\n",
 			dev_name(bsg_dev));
@@ -4028,6 +4032,38 @@ persistent_id_show(struct device *dev, struct device_attribute *attr,
 }
 static DEVICE_ATTR_RO(persistent_id);
 
+/**
+ * slot_show - SysFS callback for slot number display
+ * @dev: class device
+ * @attr: Device attributes
+ * @buf: Buffer to copy
+ *
+ * Return: snprintf() return after copying slot number
+ * of the specific device.
+ */
+static ssize_t
+slot_show(struct device *dev, struct device_attribute *attr,
+			char *buf)
+{
+	struct scsi_device *sdev = to_scsi_device(dev);
+	struct mpi3mr_sdev_priv_data *sdev_priv_data;
+	struct mpi3mr_stgt_priv_data *tgt_priv_data;
+	struct mpi3mr_tgt_dev *tgtdev;
+
+	sdev_priv_data = sdev->hostdata;
+	if (!sdev_priv_data)
+		return 0;
+
+	tgt_priv_data = sdev_priv_data->tgt_priv_data;
+	if (!tgt_priv_data)
+		return 0;
+	tgtdev = tgt_priv_data->tgt_dev;
+	if (!tgtdev)
+		return 0;
+	return snprintf(buf, PAGE_SIZE, "%u\n", tgtdev->slot);
+}
+static DEVICE_ATTR_RO(slot);
+
 #if ((KERNEL_VERSION(5, 16, 0) <= LINUX_VERSION_CODE) || \
 	(defined(CONFIG_SUSE_KERNEL) && \
 	((CONFIG_SUSE_VERSION == 15) && (CONFIG_SUSE_PATCHLEVEL >= 5))))
@@ -4036,6 +4072,7 @@ static struct attribute *mpi3mr_dev_attrs[] = {
 	&dev_attr_sas_address.attr,
 	&dev_attr_device_handle.attr,
 	&dev_attr_persistent_id.attr,
+	&dev_attr_slot.attr,
 	NULL,
 };
 
@@ -4055,6 +4092,7 @@ struct device_attribute *mpi3mr_dev_attrs[] = {
 	&dev_attr_sas_address,
 	&dev_attr_device_handle,
 	&dev_attr_persistent_id,
+	&dev_attr_slot,
 	NULL,
 };
 
diff --git a/probe_bsg_setup_queue_has_reply_len.c b/probe_bsg_setup_queue_has_reply_len.c
new file mode 100644
index 0000000..badf948
--- /dev/null
+++ b/probe_bsg_setup_queue_has_reply_len.c
@@ -0,0 +1,6 @@
+#include <linux/bsg-lib.h>
+
+void probe(struct device *dev, struct queue_limits *limits)
+{
+    bsg_setup_queue(dev, "probe", limits, NULL, NULL, 0, 0);
+}
